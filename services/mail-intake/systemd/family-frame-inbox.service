# WorkingDirectory assumes the repo is at ~/Projects/family-frame (edit if elsewhere).
[Unit]
Description=Family Frame household email: fetch forwarded Gmail and deliver it to households

[Service]
Type=oneshot
WorkingDirectory=%h/Projects/family-frame
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=INBOX_ENV_FILE=%h/.config/family-frame-inbox/env
Environment=NODE_OPTIONS=--disable-warning=ExperimentalWarning
ExecStart=/usr/bin/npm run --silent inbox:run
StandardOutput=append:%h/.local/state/family-frame-inbox/run.log
StandardError=append:%h/.local/state/family-frame-inbox/run.log
Nice=10
TimeoutStartSec=10min
